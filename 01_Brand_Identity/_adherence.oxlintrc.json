{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/content/**",
              "components/data-display/**",
              "components/feedback/**",
              "components/forms/**",
              "components/games/**",
              "components/learning/**",
              "components/media/**",
              "components/navigation/**",
              "components/surfaces/**",
              "guidelines/**",
              "ui_kits/digital-hub/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Playfair Display|Open Sans|Poppins|Great Vibes))/i]",
        "message": "Font not provided by the design system. Available: Playfair Display, Open Sans, Poppins, Great Vibes."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:severity|title|icon|onClose|action|style|children|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: severity, title, icon, onClose, action, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:success|info|warning|error|progress|devotional|achievement)$/]",
        "message": "<Alert> severity must be one of 'success' | 'info' | 'warning' | 'error' | 'progress' | 'devotional' | 'achievement'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|icon|style|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: status, icon, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:neutral|active|admin|guest|pending|suspended|points|achievement)$/]",
        "message": "<Badge> status must be one of 'neutral' | 'active' | 'admin' | 'guest' | 'pending' | 'suspended' | 'points' | 'achievement'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Crumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|icon|key|ref|className|style|children)$/]",
        "message": "<Crumb> doesn't accept that prop. Declared props: label, href, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|shape|uppercase|disabled|fullWidth|iconLeft|iconRight|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, shape, uppercase, disabled, fullWidth, iconLeft, iconRight, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary|destructive|purple|gold-outline)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary' | 'destructive' | 'purple' | 'gold-outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:default|pill)$/]",
        "message": "<Button> shape must be one of 'default' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|accent|glass|hoverable|style|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, accent, glass, hoverable, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|dark|shiny)$/]",
        "message": "<Card> variant must be one of 'default' | 'dark' | 'shiny'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|icon|eyebrow|title|description|action|style|key|ref|className|style|children)$/]",
        "message": "<CategoryCard> doesn't accept that prop. Declared props: category, icon, eyebrow, title, description, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|level|icon|style|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: tone, level, icon, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|gold|teal|purple|orange|navy|level)$/]",
        "message": "<Chip> tone must be one of 'neutral' | 'gold' | 'teal' | 'purple' | 'orange' | 'navy' | 'level'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CrosswordEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:answer|clue|row|col|dir|key|ref|className|style|children)$/]",
        "message": "<CrosswordEntry> doesn't accept that prop. Declared props: answer, clue, row, col, dir."
      },
      {
        "selector": "JSXOpeningElement[name.name='CrosswordEntry'] > JSXAttribute[name.name='dir'] > Literal[value!=/^(?:across|down)$/]",
        "message": "<CrosswordEntry> dir must be one of 'across' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:gradient|icon|eyebrow|title|description|style|children|key|ref|className|style|children)$/]",
        "message": "<FeatureCard> doesn't accept that prop. Declared props: gradient, icon, eyebrow, title, description, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GalleryItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|src|alt|caption|meta|category|key|ref|className|style|children)$/]",
        "message": "<GalleryItem> doesn't accept that prop. Declared props: id, src, alt, caption, meta, category."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|required|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, required, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:pattern|open|onClose|icon|eyebrow|title|children|actions|width|style|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: pattern, open, onClose, icon, eyebrow, title, children, actions, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute[name.name='pattern'] > Literal[value!=/^(?:locked|consent|achievement|welcome|plain)$/]",
        "message": "<Modal> pattern must be one of 'locked' | 'consent' | 'achievement' | 'welcome' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute > JSXIdentifier[name!=/^(?:page|pageCount|onChange|perPage|onPerPageChange|perPageOptions|summary|style|key|ref|className|style|children)$/]",
        "message": "<Pagination> doesn't accept that prop. Declared props: page, pageCount, onChange, perPage, onPerPageChange, perPageOptions, summary, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:layout|cover|category|title|excerpt|author|date|readTime|href|style|key|ref|className|style|children)$/]",
        "message": "<PostCard> doesn't accept that prop. Declared props: layout, cover, category, title, excerpt, author, date, readTime, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:stacked|horizontal|feature)$/]",
        "message": "<PostCard> layout must be one of 'stacked' | 'horizontal' | 'feature'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuizQuestion'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|total|question|options|correct|explanation|onAnswer|value|style|key|ref|className|style|children)$/]",
        "message": "<QuizQuestion> doesn't accept that prop. Declared props: index, total, question, options, correct, explanation, onAnswer, value, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|quote|emphasis|attribution|date|portrait|lockup|emblem|hashtag|style|key|ref|className|style|children)$/]",
        "message": "<QuoteCard> doesn't accept that prop. Declared props: index, quote, emphasis, attribution, date, portrait, lockup, emblem, hashtag, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|count|tone|key|ref|className|style|children)$/]",
        "message": "<SidebarItem> doesn't accept that prop. Declared props: id, label, icon, count, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:activity|error)$/]",
        "message": "<SidebarItem> tone must be one of 'activity' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StudyLesson'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|state|duration|key|ref|className|style|children)$/]",
        "message": "<StudyLesson> doesn't accept that prop. Declared props: id, title, state, duration."
      },
      {
        "selector": "JSXOpeningElement[name.name='StudyLesson'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:done|current|todo|locked)$/]",
        "message": "<StudyLesson> state must be one of 'done' | 'current' | 'todo' | 'locked'."
      },
